{
  "name": "logseq-ai-actions",
  "version": "0.0.0",
  "description": "AI-driven actions on Logseq blocks — spellcheck, grammar, rewrite, summarize via a local OpenAI-compatible endpoint (LM Studio / Ollama).",
  "keywords": [
    "logseq",
    "logseq-plugin",
    "ai",
    "llm",
    "ollama",
    "lm-studio"
  ],
  "author": "Danzu <hdansou@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdansou/logseq-ai-actions.git"
  },
  "bugs": {
    "url": "https://github.com/hdansou/logseq-ai-actions/issues"
  },
  "homepage": "https://github.com/hdansou/logseq-ai-actions#readme",
  "type": "module",
  "main": "dist/index.html",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "echo 'TODO: Playwright suite lands in Phase 9' && exit 1",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@logseq/libs": "^0.3.2",
    "diff": "^9.0.0",
    "preact": "^10.29.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "^4.1.0",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --write --no-errors-on-unmatched && pnpm typecheck"
  },
  "logseq": {
    "id": "logseq-ai-actions",
    "title": "AI Actions",
    "icon": "./icon.png",
    "main": "dist/index.html"
  }
}
