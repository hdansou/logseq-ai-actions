{
  "name": "logseq-ai-actions",
  "version": "1.3.0",
  "description": "Logseq DB-graph plugin: AI actions on your blocks (spellcheck, grammar, rewrite with tones, summarize, key points, outlines, image titles and OCR) using a local OpenAI-compatible LLM like LM Studio or Ollama. Privacy-first: asks before sending anything to a remote host.",
  "keywords": [
    "logseq",
    "logseq-plugin",
    "ai",
    "llm",
    "ollama",
    "lm-studio"
  ],
  "author": "Danzu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdansou/logseq-ai-actions.git"
  },
  "bugs": {
    "url": "https://github.com/hdansou/logseq-ai-actions/issues"
  },
  "homepage": "https://github.com/hdansou/logseq-ai-actions#readme",
  "type": "module",
  "main": "dist/index.html",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "predev": "rm -rf dist",
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@logseq/libs": "^0.3.4",
    "diff": "^9.0.0",
    "preact": "^10.29.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --write --no-errors-on-unmatched && pnpm typecheck"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.1",
      "dompurify": "^3.4.16"
    }
  },
  "logseq": {
    "id": "logseq-ai-actions",
    "title": "AI Actions",
    "icon": "./icon.png",
    "main": "dist/index.html",
    "minSDKVersion": "0.3.4",
    "supportsDB": true,
    "supportsDBOnly": true
  }
}
